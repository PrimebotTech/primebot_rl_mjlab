-  """Cosine and sine of the pole hinge angle. Shape: [num_envs, 2]."""
-  asset: Entity = env.scene[asset_cfg.name]
-  angle = asset.data.joint_pos[:, asset_cfg.joint_ids]
-  return torch.cat([torch.cos(angle), torch.sin(angle)], dim=-1)
